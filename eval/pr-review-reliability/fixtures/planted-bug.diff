-    if (!entry) return false;
-    return Date.now() < entry.expiresAt;
-  }
-
-  get(key: string): T | undefined {
-    if (!this.has(key)) return undefined;
-    return this.store.get(key)!.value;
+  /** Returns the cached value, or fetches and stores it on miss. */
+  async getOrFetch(key: string, fetch: () => Promise<T>): Promise<T> {
+    const entry = this.store.get(key);
+    if (entry && Date.now() < entry.expiresAt) {
+      return entry.value;
+    }
+    // BUG: missing `await` — fetch() result is a Promise<T>, not T.
+    // The unresolved Promise is stored as the cached value and returned.
+    const value = fetch();
+    this.store.set(key, { value: value as unknown as T, expiresAt: Date.now() + this.ttlMs });
+    return value as unknown as T;
