# OpenAI — also required on the Convex deployment (see note below)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Optional OpenAI-compatible base URL for local coding tools or alternate gateways.
# Example for Azure OpenAI v1-compatible tools:
# OPENAI_BASE_URL=https://<azure-openai-resource>.openai.azure.com/openai/v1
OPENAI_BASE_URL=
# Use `api-key` for Azure-style endpoints when driving them through OPENAI_BASE_URL.
OPENAI_API_KEY_HEADER=authorization
OPENAI_REASONING_EFFORT=none

# ── Switchable model runtime ───────────────────────────────────────────────
# openai       = use OPENAI_API_KEY / OPENAI_MODEL
# azure-openai = use Azure OpenAI / Azure AI Foundry OpenAI deployments
# foundry      = use Microsoft Foundry Models chat-completions deployments
# disabled     = fail fast; Convex fallbacks stop remote model spend
ARBOR_MODEL_PROVIDER=openai
# openai = use your OpenAI credits for hive planner/evaluator too.
# auto keeps Anthropic/OpenRouter/OpenAI fallback order.
ARBOR_HIVE_MODEL_PROVIDER=openai
ARBOR_AZURE_ENABLED=false
# When true, direct OpenAI fallback is blocked. Use this in Azure-credit mode.
ARBOR_REQUIRE_AZURE=false
# Immediate spend kill switch checked before every model call.
ARBOR_MODEL_SPEND_DISABLED=false
# Isolated non-production preview only: blocks Next API routes and narrows
# Convex execution to one fixed, idempotent deterministic Hive smoke task.
ARBOR_PUBLIC_DEMO_MODE=false
# Optional output-token cap for all model calls, with per-purpose overrides.
ARBOR_MAX_OUTPUT_TOKENS=
ARBOR_AGENT_MAX_OUTPUT_TOKENS=
ARBOR_JUDGE_MAX_OUTPUT_TOKENS=
ARBOR_SUGGESTER_MAX_OUTPUT_TOKENS=
ARBOR_MODEL=
ARBOR_AGENT_MODEL=
ARBOR_JUDGE_MODEL=
ARBOR_SUGGESTER_MODEL=
ARBOR_INTAKE_MODEL=
ARBOR_PLANNER_MODEL=
ARBOR_DISCOVERY_MODEL=
ARBOR_DEMO_MODEL=

# ── OpenRouter gateway + 2026 frontier roster (docs/api-keys.md) ───────────
# Master switch: when true, callOpenAI() routes through OpenRouter under
# OPENROUTER_API_KEY instead of OPENAI_API_KEY/Azure/Foundry. Off by default.
ARBOR_OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
# Purpose-less default slug, used when no OPENROUTER_<PURPOSE>_MODEL is set.
OPENROUTER_MODEL=
# Hard/abstract reasoning + planner-on-hard-tasks.
OPENROUTER_PLANNER_MODEL=openai/gpt-5.5
# Default/tool-loop/high-volume node — value leader; verbose, pair with
# ARBOR_AGENT_MAX_OUTPUT_TOKENS above to cap output.
OPENROUTER_AGENT_MODEL=google/gemini-3.5-flash
OPENROUTER_JUDGE_MODEL=
OPENROUTER_SUGGESTER_MODEL=
OPENROUTER_INTAKE_MODEL=
OPENROUTER_DISCOVERY_MODEL=
OPENROUTER_DEMO_MODEL=
# Optional endpoint/attribution overrides.
OPENROUTER_BASE_URL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=

# Azure OpenAI / Foundry OpenAI v1. Prefer Responses API for GPT-5 deployments.
# Set these in both Next/Vercel and Convex when Arbor model calls run in Convex.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_MODE=responses
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_AGENT_DEPLOYMENT=gpt5-agent
AZURE_OPENAI_JUDGE_DEPLOYMENT=arbor-judge-base
AZURE_OPENAI_SUGGESTER_DEPLOYMENT=arbor-suggester-base
AZURE_OPENAI_AGENT_BASE_MODEL=gpt-5
AZURE_OPENAI_AGENT_MODEL_VERSION=2025-08-07
AZURE_OPENAI_AGENT_SKU=GlobalStandard
AZURE_OPENAI_JUDGE_BASE_MODEL=gpt-4.1-mini
AZURE_OPENAI_JUDGE_BASE_MODEL_VERSION=2025-04-14
AZURE_OPENAI_JUDGE_SKU=GlobalStandard
AZURE_OPENAI_SUGGESTER_BASE_MODEL=gpt-4.1-mini
AZURE_OPENAI_SUGGESTER_BASE_MODEL_VERSION=2025-04-14
AZURE_OPENAI_SUGGESTER_SKU=GlobalStandard
AZURE_OPENAI_JUDGE_FINE_TUNED_DEPLOYMENT=arbor-judge
AZURE_OPENAI_SUGGESTER_FINE_TUNED_DEPLOYMENT=arbor-suggester
AZURE_OPENAI_INTAKE_DEPLOYMENT=
AZURE_OPENAI_PLANNER_DEPLOYMENT=
AZURE_OPENAI_DISCOVERY_DEPLOYMENT=
AZURE_OPENAI_DEMO_DEPLOYMENT=
# Deployment/admin metadata used by `npm run azure:ft -- deploy` and shutoff.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=northcentralus
AZURE_NAME_PREFIX=arbor
AZURE_BUDGET_EMAIL=
AZURE_BUDGET_NAME=arbor-azure-credits-guardrail
AZURE_CREDITS_TOTAL=10000
AZURE_MONTHLY_BUDGET=9500
AZURE_BUDGET_START=2026-06-01T00:00:00Z
AZURE_BUDGET_END=2027-06-01T00:00:00Z
AZURE_OPENAI_RESOURCE_NAME=
AZURE_CONTAINER_APP_NAME=
AZURE_WEBAPP_NAME=
AZURE_MANAGEMENT_TOKEN=

# Microsoft Foundry Models non-OpenAI deployments, e.g. DeepSeek/Grok/etc.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_INFERENCE_CREDENTIAL=
AZURE_FOUNDRY_API_VERSION=2024-10-21
AZURE_FOUNDRY_DEPLOYMENT=
AZURE_FOUNDRY_AGENT_DEPLOYMENT=
AZURE_FOUNDRY_JUDGE_DEPLOYMENT=
AZURE_FOUNDRY_SUGGESTER_DEPLOYMENT=

# Convex (populated by `npx convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# ── Convex backend env (required for auctions) ─────────────────────────────
# Specialist bidding/execution runs in Convex actions, NOT inside Next.js.
# Values in .env.local are only seen by Next (MCP route, pages). For Convex,
# set the same keys on your dev deployment, e.g.:
#   npx convex env set OPENAI_API_KEY 'sk-...'
#   npx convex env set ARBOR_MODEL_PROVIDER azure-openai
#   npx convex env set AZURE_OPENAI_ENDPOINT 'https://<resource>.openai.azure.com'
#   npx convex env set AZURE_OPENAI_API_KEY '...'
#   npx convex env set AZURE_OPENAI_AGENT_DEPLOYMENT gpt5-agent
#   npx convex env set AZURE_OPENAI_JUDGE_DEPLOYMENT arbor-judge
#   npx convex env set AZURE_OPENAI_SUGGESTER_DEPLOYMENT arbor-suggester
# Emergency all-model-spend shutoff:
#   npx convex env set ARBOR_MODEL_PROVIDER disabled
# Or: Dashboard → your deployment → Settings → Environment Variables.
# Optional: `npx convex env set --from-file .env.convex` with a local file.

# Public host used by the MCP endpoint to return web_view_url back to callers
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Real payments (disabled unless ARBOR_PAYMENTS_MODE=stripe_checkout) ────
# Keep unset for simulated Convex escrow. When enabled, set these in both
# Next/Vercel and Convex where noted:
#   npx convex env set ARBOR_PAYMENTS_MODE stripe_checkout
#   npx convex env set STRIPE_SECRET_KEY sk_test_...
#   npx convex env set STRIPE_CURRENCY usd
ARBOR_PAYMENTS_MODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_CONNECT_COUNTRY=US
STRIPE_CONNECT_BUSINESS_URL=http://localhost:3000
STRIPE_CONNECT_PRODUCT_DESCRIPTION=Arbor agent marketplace services
ARBOR_PLATFORM_FEE_BPS=1000
# Optional but recommended in production. Set the same value in Next and Convex
# so verified Next Stripe routes can update Convex payment state.
ARBOR_STRIPE_CONVEX_BRIDGE_SECRET=

# Optional sponsor integrations (mocked if absent)
REACHER_API_KEY=
NIA_API_KEY=
HYPERSPELL_API_KEY=hs-0-xxxxxxxxxxxxxxxxxxxxxx
HYPERSPELL_USER_ID=
TENSORLAKE_API_KEY=
DEVIN_API_KEY=
# Required for Devin MCP when DEVIN_API_KEY is account-scoped instead of org-scoped.
DEVIN_ORG_ID=
V0_API_KEY=
# InsForge backend (mcp-forwarding over https://mcp.insforge.dev/mcp).
# BOTH are required — the hosted MCP uses project-scoped "legacy" auth:
#   X-Api-Key + X-Base-URL. Without both, insforge-backend declines and drops
#   to the demo lane. Grab the key + your project's base URL from the InsForge
#   dashboard (these are not copy-pasteable OAuth tokens).
INSFORGE_API_KEY=
INSFORGE_API_BASE_URL=

# Popular MCP connectors. Set the *_MCP_ENDPOINT to a streamable HTTP endpoint;
# add the matching token/env only when the MCP server requires it.
GITHUB_MCP_ENDPOINT=
CONTEXT7_MCP_ENDPOINT=https://mcp.context7.com/mcp
PLAYWRIGHT_MCP_ENDPOINT=
FIGMA_MCP_ENDPOINT=
FIGMA_ACCESS_TOKEN=
SUPABASE_MCP_ENDPOINT=
SUPABASE_ACCESS_TOKEN=
POSTGRES_MCP_ENDPOINT=
DATABASE_URL=
POSTGRES_URL=
NEON_MCP_ENDPOINT=
NEON_API_KEY=
LINEAR_MCP_ENDPOINT=
LINEAR_API_KEY=
SENTRY_MCP_ENDPOINT=
SENTRY_AUTH_TOKEN=
STRIPE_MCP_ENDPOINT=
VERCEL_MCP_ENDPOINT=
VERCEL_TOKEN=
DOCKER_MCP_ENDPOINT=
KUBERNETES_MCP_ENDPOINT=
KUBECONFIG=
FIRECRAWL_MCP_ENDPOINT=
FIRECRAWL_API_KEY=
EXA_MCP_ENDPOINT=
EXA_API_KEY=
ZAPIER_MCP_ENDPOINT=
ZAPIER_MCP_API_KEY=
PIPEDREAM_MCP_ENDPOINT=
PIPEDREAM_API_KEY=
COMPOSIO_MCP_ENDPOINT=
COMPOSIO_API_KEY=

# External A2A endpoints — specialists are disabled when these are absent
TENSORLAKE_A2A_ENDPOINT=
TENSORLAKE_A2A_AGENT_CARD_URL=
DEVIN_A2A_ENDPOINT=
DEVIN_A2A_AGENT_CARD_URL=
CONVEX_A2A_ENDPOINT=
CONVEX_A2A_AGENT_CARD_URL=

# Standalone Arbor A2A worker (a2a-worker/). Run it with
#   cd a2a-worker && npm install && PORT=4000 npm start
# then point Arbor at it. ARBOR_WORKER_BEARER only if the worker sets
# WORKER_BEARER_TOKEN.
ARBOR_WORKER_A2A_ENDPOINT=
ARBOR_WORKER_A2A_AGENT_CARD_URL=
ARBOR_WORKER_BEARER=

# Arbor Code Team (scripts/code-team-a2a.ts). Run it with
#   PORT=4100 npm run code-team:a2a
# then point Arbor at it. ARBOR_CODE_TEAM_BEARER is shared: the service
# requires it when set, and Arbor sends it.
ARBOR_CODE_TEAM_A2A_ENDPOINT=
ARBOR_CODE_TEAM_A2A_AGENT_CARD_URL=
ARBOR_CODE_TEAM_BEARER=

# Runtime A2A discovery directory — comma-separated base URLs of A2A agents.
# discover_specialist fetches each agent card and can mint tier:"a2a"
# specialists on demand. Empty = a2a discovery stage is skipped.
ARBOR_A2A_DIRECTORY=

# Anthropic (hive mind layers)
# Required by the planner/router/evaluator layers. Set this in Next/Vercel and
# on the Convex deployment, for example:
#   npx convex env set ANTHROPIC_API_KEY 'sk-ant-...'
ANTHROPIC_API_KEY=
# Optional: force deterministic local-hash embeddings for hive registry and
# scratchpad recall. Set in both Next/Vercel and Convex for consistent behavior.
HIVE_EMBEDDINGS_FORCE_LOCAL=false
# Optional: route all new tasks through the hive DAG planner by default. Must be
# set on the Convex deployment to affect tasks.post.
ARBOR_HIVE_DEFAULT=false
# Optional: encode structured agent-to-LLM payloads (judge output schema, eval-
# gate grader input) as TOON instead of JSON to save ~30-70% of those tokens.
# Default off (JSON, unchanged). Set on Convex too to affect server-side prompts.
# https://github.com/toon-format/toon
ARBOR_TOON_ENABLED=false
# Emergency kill switch — true forces JSON everywhere, beats the enable flag.
ARBOR_TOON_DISABLED=false

# Optional: Sakana-style best-of-N candidate search (AB-MCTS pattern). When true,
# high-value DAG nodes fan out into K parallel candidate executions and the judge
# promotes the best output; the node's budget is split across candidates so total
# spend is unchanged. Default off = single-winner-per-node, byte-for-byte
# unchanged. Set on the Convex deployment to affect the hive.
ARBOR_HIVE_BESTOFN_ENABLED=false
# Emergency kill switch — true forces single-winner everywhere.
ARBOR_HIVE_BESTOFN_DISABLED=false
# Max candidates per node (clamped 1..5) and the minimum per-candidate budget a
# node must be able to afford twice over before it fans out.
ARBOR_HIVE_BESTOFN_MAX=3
ARBOR_HIVE_BESTOFN_MIN_BUDGET=10
# Liveness deadline (seconds past the bid window, clamped 60..3600) after which
# a fanned-out node promotes from whatever candidates settled instead of waiting
# forever for stragglers.
ARBOR_HIVE_BESTOFN_DEADLINE_SECONDS=600
# Optional: orchestrator-first direct assignment. When true, a DAG node whose
# market is thin (fewer than ARBOR_DIRECT_ROUTE_LIQUIDITY independent ready
# candidates) skips the bid round: the top profile-ranked ready agent is
# assigned directly via a single synthetic bid and resolve runs immediately, so
# escrow/execute/judge/settle and the W6 floor backstop are unchanged. Auctions
# still run for liquid markets, force_open retries, best-of-N fan-outs, and
# consensus revisions. Default off = every node auctions, byte-for-byte
# unchanged. Set on the Convex deployment to affect the hive.
ARBOR_ORCHESTRATOR_FIRST_ENABLED=false
# Emergency kill switch — true forces the auction path everywhere.
ARBOR_ORCHESTRATOR_FIRST_DISABLED=false
# Independent ready candidates at/above which the market counts as liquid and
# a real auction runs (clamped 2..10).
ARBOR_DIRECT_ROUTE_LIQUIDITY=3
# Optional: Fugu-inspired confidence-gated expert delegation. A bundled,
# query-conditioned selection head (the bundled seed uses curated gold proxy
# labels; `npm run delegation:train -- --data <measured.jsonl>` accepts real
# per-worker reward vectors) ranks known agents; same-task-class exact outcome
# counts, a conservative success bound, semantic fit, and rank margin decide
# whether to skip the auction. Unknown agents keep their 4D rank. Low-confidence
# auctions may prune six non-floor invitees to three. Arbor policy, not Sakana's
# private model or thresholds. Default off.
ARBOR_EXPERT_DELEGATION_ENABLED=false
# Emergency kill switch; beats both enabled and shadow modes.
ARBOR_EXPERT_DELEGATION_DISABLED=false
# Evaluate/log expert decisions without changing assignment or invite count.
ARBOR_EXPERT_DELEGATION_SHADOW=false
# Minimum exact-class outcomes for expert routing/pruning (default 8, 5..50).
ARBOR_EXPERT_MIN_TASKS=8
# Optional: Sakana evolution archive for reversible artifacts (prompt templates,
# rubric weights, DAG priors, role specs, tool allowlists). Enables proposing +
# evaluating evolved genomes. Promotion ALWAYS requires explicit approval — this
# flag never auto-promotes. Default off.
ARBOR_HIVE_EVOLUTION_ENABLED=false
